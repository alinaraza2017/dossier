rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User private data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /scholarships/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /requirements/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /documents/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /settings/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // System-only collections (read only or managed solely by Cloud Functions)
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /trialClaims/{claimId} {
      allow read, write: if false;
    }
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    match /aiUsage/{usageId} {
      allow read: if request.auth != null && usageId.matches('^' + request.auth.uid + '.*');
      allow write: if false;
    }
  }
}
