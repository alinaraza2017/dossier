# Dossier Environment Configuration Template
# Copy this file to .env or configure through the in-app AI settings.
# IMPORTANT: Never commit your real API key to version control.

# Supported providers: gemini, openai, custom
AI_PROVIDER=gemini

# For Google Gemini API (default free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# For OpenAI compatible endpoints (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
